#!/usr/bin/env bash
# Runs the gate CI runs, so a failure shows up here with its file and line, not as a red PR.
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "==> type check"
bun run check
echo "==> lint"
bun run lint
echo "==> token lint"
bun run check:tokens
echo "==> test"
bun test
echo "==> build"
bun run build

---
import Container from '@/components/Container.astro'
import { SOCIAL_LINKS } from '@/consts'
import Link from './Link.astro'
---

<footer class="py-4 pb-[max(2rem,env(safe-area-inset-bottom))] sm:pb-12">
  <Container>
    <div
      class="footer-panel glass-card backdrop-blur-md flex flex-col items-center justify-center gap-3 px-4 py-3 sm:grid sm:grid-cols-[1fr_auto]"
    >
      <div class="flex items-center gap-x-2">
        <div class="sm:flex sm:flex-row sm:gap-x-4 sm:items-center sm:justify-center">
          <span class="text-center text-sm text-foreground/80 sm:mb-0">
            &copy; {new Date().getFullYear()} All rights reserved.
          </span>
        </div>
      </div>
      <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-self-end">
        <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-foreground/80">
          <Link href="/privacy" class="text-foreground">Privacy</Link>
          <span aria-hidden="true">·</span>
          <Link href="/terms" class="text-foreground">Terms</Link>
          {
            SOCIAL_LINKS.map((link) => (
              <>
                <span aria-hidden="true">·</span>
                <Link
                  href={link.label === 'Email' ? `mailto:${link.href}` : link.href}
                  class="text-foreground"
                  external
                >
                  {link.label}
                </Link>
              </>
            ))
          }
        </p>
      </div>
    </div>
  </Container>
</footer>
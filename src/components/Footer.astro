---
import Container from '@/components/Container.astro'
import { Separator } from '@/components/ui/Separator'
import { SOCIAL_LINKS } from '@/consts'
import Link from './Link.astro'
import SocialIcons from './SocialIcons.astro'
import BackToTop from './BackToTop.astro'
---

<footer class="py-4 pb-[max(2rem,env(safe-area-inset-bottom))] sm:pb-12">
  <Container>
    <div
      class="footer-panel flex flex-col items-center justify-center gap-3 px-4 py-3 sm:grid sm:grid-cols-[1fr_auto_1fr]"
    >
      <div class="flex items-center gap-x-2">
        <div class="sm:flex sm:flex-row sm:gap-x-4 sm:items-center sm:justify-center">
          <span class="text-center text-sm text-foreground/80 sm:mb-0">
            &copy; {new Date().getFullYear()} All rights reserved.
          </span>
          <Separator orientation="vertical" className="h-4 hidden sm:block" />
          <p class="text-center text-sm text-foreground/80 sm:mb-0">
            Made with 🤍 by <Link
              href="https://linktr.ee/naandalist"
              class="text-foreground"
              external
              underline>naandalist</Link
            >
          </p>
        </div>
      </div>
      <BackToTop />
      <SocialIcons links={SOCIAL_LINKS} className="sm:justify-self-end" />
    </div>
    <BackToTop float />
  </Container>
</footer>
---
import { type CollectionEntry, render } from "astro:content";

import { useTranslations } from "@i18n/utils";

import BackToPrev from "@components/BackToPrev.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import JsonLd from "@components/JsonLd.astro";

import PageLayout from "@layouts/PageLayout.astro";

import {
  createCreativeWorkSchema,
  createNewsMediaOrganizationSchema,
  createSoftwareApplicationSchema,
  createWebSiteSchema,
} from "@lib/jsonld";
import { readingTime } from "@lib/utils";

interface Props {
  project: CollectionEntry<"projects">;
  lang?: "en" | "id";
}

const { project, lang = "en" } = Astro.props;
const { Content } = await render(project);
const t = useTranslations(lang);
const backHref = lang === "id" ? "/id/projects" : "/projects";

const schemas: Record<string, unknown>[] = [createCreativeWorkSchema(project)];

if (project.data.category && project.data.platforms) {
  schemas.push(createSoftwareApplicationSchema(project));
}

if (project.id.includes("news") || project.data.category === "News & Media") {
  schemas.push(createNewsMediaOrganizationSchema(project));
  if (project.data.liveURL) {
    schemas.push(createWebSiteSchema(project));
  }
}
---

<PageLayout
  title={project.data.title}
  description={project.data.description}
  image={project.data.imageUrl?.src}
>
  <JsonLd schema={schemas} />
  <Container>
    <div class="animate">
      <BackToPrev href={backHref}> {t("projects.back")} </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={project.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(project.body ?? "")}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-white">
        {project.data.title}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>

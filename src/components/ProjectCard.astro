---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import { normalizeSlug } from "@lib/utils";

type Props = {
  entry: CollectionEntry<"projects">;
  lang?: "en" | "id";
};

const { entry, lang = "en" } = Astro.props;
const baseUrl = lang === "id" ? "/id" : "";
const cleanSlug = normalizeSlug(entry.id);
const projectUrl = `${baseUrl}/projects/${cleanSlug}`;
---

<div
  class="group card-hover relative flex flex-col sm:flex-row gap-4 p-4 rounded-lg border border-white/20"
>
  <a
    href={projectUrl}
    class="relative w-full sm:w-48 h-32 shrink-0 overflow-hidden rounded-md bg-gradient-to-r from-cyan-500 to-blue-500"
  >
    {
      entry.data.imageUrl ? (
        <Image
          src={entry.data.imageUrl}
          alt={`${entry.data.title} preview`}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          width={384}
          height={256}
          widths={[384, 768]}
          sizes="(max-width: 640px) 100vw, 384px"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center">
          <img
            src="/icons/image.svg"
            alt="Project placeholder"
            class="h-12 w-12 opacity-20"
          />
        </div>
      )
    }
  </a>

  <div class="flex flex-1 flex-col gap-2">
    <a href={projectUrl} class="block">
      <h3 class="font-semibold text-lg text-white">
        {entry.data.title}
      </h3>
      <p class="text-sm text-white/70 mt-1 line-clamp-2">
        {entry.data.description}
      </p>
    </a>

    <div class="flex items-end justify-between gap-2 mt-auto">
      {
        entry.data.techStack && entry.data.techStack.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5">
            {entry.data.techStack.map((tech: string) => (
              <span class="text-xs px-2 py-0.5 rounded-md bg-white/10 text-white/70">
                {tech}
              </span>
            ))}
          </div>
        )
      }

      {
        (entry.data.liveURL || entry.data.repoURL) && (
          <a
            href={entry.data.liveURL || entry.data.repoURL}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 p-2 rounded-md hover:opacity-70 transition-opacity duration-200 ml-auto translate-y-0.5"
            aria-label="Open project link"
          >
            <img
              src="/icons/top-right.svg"
              alt="External link"
              class="w-4 h-4 transition-transform duration-300 ease-in-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none"
            />
          </a>
        )
      }
    </div>
  </div>
</div>

---
/**
 * The site name with a percentage progress bar below it, shown while a page change is slow. It does nothing on the first page
 * load and for fast navigations, see src/lib/nav-loader.ts for the timing and the fake progress curve. It persists across page
 * swaps.
 */
---

<div id="nav-loader" class="nav-loader" data-state="idle" role="status" aria-live="polite" transition:persist>
  <div class="nav-stage" aria-hidden="true">
    <p class="nav-name">Please wait</p>
    <div class="nav-track">
      <div class="nav-fill" data-fill style="width: 0%">
        <span class="nav-percent" data-percent>0%</span>
      </div>
    </div>
  </div>
  <span class="sr-only" data-label>Loading page</span>
</div>

<style>
  .nav-loader {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    background: hsl(var(--background) / 0.9);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease-out, visibility 0s 0.15s;
  }
  .nav-loader[data-state='visible'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.15s ease-out;
  }
  .nav-stage {
    display: grid;
    justify-items: stretch;
    gap: 0.75rem;
    color: hsl(var(--foreground));
  }
  .nav-name {
    margin: 0;
    font-family: 'Geist', ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.2;
    text-align: center;
  }
  /* A pill track that fills with the live fake-progress percentage, so the screen is never empty. */
  .nav-track {
    width: 16rem;
    max-width: 60vw;
    height: 2rem;
    border-radius: 9999px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.18);
  }
  .nav-fill {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-inline-end: 0.625rem;
    border-radius: 9999px;
    background: hsl(var(--foreground));
    transition: width 0.2s ease-out;
  }
  .nav-percent {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: hsl(var(--background));
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-fill { transition: none; }
  }
</style>

<script>
  import { createNavLoader } from '@/lib/nav-loader'

  const root = () => document.getElementById('nav-loader')
  const setProgress = (pct: number) => {
    const node = root()
    const fill = node?.querySelector<HTMLElement>('[data-fill]')
    const label = node?.querySelector<HTMLElement>('[data-percent]')
    const whole = Math.round(pct)
    if (fill) fill.style.width = `${pct}%`
    if (label) label.textContent = `${whole}%`
  }
  const loader = createNavLoader({
    show: () => root()?.setAttribute('data-state', 'visible'),
    hide: () => {
      root()?.setAttribute('data-state', 'idle')
      setProgress(0)
    },
    onProgress: setProgress,
  })

  document.addEventListener('astro:before-preparation', () => loader.start())
  document.addEventListener('astro:after-swap', () => loader.done())
</script>

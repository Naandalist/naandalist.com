---
import { type CollectionEntry, render } from "astro:content";

import { useTranslations } from "@i18n/utils";

import BackToPrev from "@components/BackToPrev.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";

import PageLayout from "@layouts/PageLayout.astro";

import { readingTime } from "@lib/utils";

interface Props {
  pkg: CollectionEntry<"npmjs">;
  lang?: "en" | "id";
}

const { pkg, lang = "en" } = Astro.props;
const { Content } = await render(pkg);
const t = useTranslations(lang);
const backHref = lang === "id" ? "/id/npmjs" : "/npmjs";
---

<PageLayout title={pkg.data.title} description={pkg.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href={backHref}> {t("npmjs.back")} </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={pkg.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(pkg.body ?? "")}
        </div>
        {
          pkg.data.version && (
            <>
              &bull;
              <div class="font-base text-sm">v{pkg.data.version}</div>
            </>
          )
        }
      </div>
      <div class="animate text-2xl font-semibold text-white">
        {pkg.data.title}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>

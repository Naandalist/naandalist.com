---
/**
 * Scene card: a dithered plant with the logo character drawn faintly. It is the About card and the
 * base of the error pages. On hover, focus or tap the character fills in and speech bubbles slide in.
 */
import BabysBreathField from '@/components/profile/BabysBreathField'

interface Props {
  label: string
  nickname: string
  bubbles: string[]
  class?: string
  /** Baby's breath stands still by default. A dandelion has no horizon, so it is drawn flat. */
  plant?: 'babys-breath' | 'dandelion'
  animate?: boolean
}

const { label, nickname, bubbles, class: className, plant = 'babys-breath', animate = false } = Astro.props
const dandelion = plant === 'dandelion'
---

<div
  class:list={['scene about-card isolate relative min-h-60 overflow-hidden', className]}
  tabindex="0"
  role="group"
  aria-label={`${label} ${nickname}`}
>
  {dandelion ? (
    <BabysBreathField client:visible scene="dandelion" cell={2} animate={animate} className="absolute inset-x-0 bottom-0 h-3/5 w-full text-foreground/60" />
  ) : (
    <BabysBreathField client:visible animate={animate} perspective={0.25} className="horizon-fade absolute inset-x-0 bottom-0 h-3/5 w-full text-foreground/60" />
  )}

  <div class="scene-person absolute -bottom-22 left-3 flex w-24 flex-col-reverse items-center sm:w-28" aria-hidden="true">
    <svg class="scene-body h-40 w-[150%] -translate-y-6 text-foreground" viewBox="0 0 140 130" preserveAspectRatio="none" focusable="false">
      <!-- Torso with sloping shoulders, then the two arms hanging down on either side. -->
      <path d="M6 130 L8 58 Q10 34 36 28 L54 22 Q70 32 86 22 L104 28 Q130 34 132 58 L134 130 Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
      <path class="scene-arm" d="M30 44 Q26 80 28 130 M110 44 Q114 80 112 130" fill="none" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
    </svg>
    <div class="relative aspect-square w-full">
      <span class="scene-ring absolute inset-0 rounded-full"></span>
      <img
        src="/static/profile/avatar-ink.png"
        alt=""
        width="512"
        height="573"
        loading="lazy"
        decoding="async"
        class="scene-ink absolute left-1/2 top-1/2 h-[92%] w-auto -translate-x-1/2 -translate-y-1/2 select-none"
        draggable="false"
      />
    </div>
  </div>

  <div class="scene-idle absolute right-5 top-5 flex max-w-3/4 flex-col sm:max-w-[45%] items-end gap-2 text-right">
    <p data-scene="label" class="font-mono text-xs uppercase tracking-widest text-muted-foreground">{label}</p>
    <p class="font-title text-4xl sm:text-display text-foreground">{nickname}</p>
  </div>

  <div class="absolute inset-y-4 right-4 left-[44%] flex flex-col justify-center gap-2" aria-hidden="false">
    {bubbles.map((text, i) => (
      <p data-scene="bubble" class="scene-bubble rounded-lg border border-border bg-background/90 p-3 text-sm text-foreground shadow-2 backdrop-blur-sm" style={`--i:${i}`}>
        {text}
      </p>
    ))}
  </div>
</div>

<style>
  /* Follows the theme: the page tokens flip in dark mode, and so does the ink logo. */
  .scene { background: hsl(var(--foreground) / 0.05); }
  :global(.dark) .scene-ink { filter: invert(1); }
  /* Idle: only an outlined head circle and body. Hover: head, face and body fill in and the figure rises. */
  /* The figure leans in from the bottom-left corner. */
  .scene-person { transform: rotate(5deg); transform-origin: 0 100%; transition: transform 0.3s cubic-bezier(0.34, 1.3, 0.64, 1); }
  .scene-ring { border: 1.5px solid hsl(var(--foreground) / 0.55); }
  .scene-ink { opacity: 0; transition: opacity 0.2s ease; }
  .scene-ring { transition: opacity 0.2s ease; }
  .scene-body path { fill-opacity: 0; stroke-opacity: 0.55; transition: fill-opacity 0.2s ease, stroke-opacity 0.2s ease; }
  .scene-arm { stroke: hsl(var(--foreground) / 0.55); transition: stroke 0.2s ease; }
  .scene-idle { transition: opacity 0.15s ease; }
  .scene-bubble {
    position: relative;
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    transition: opacity 0.2s ease, transform 0.2s ease;
    transition-delay: 0s;
  }
  /* Little tail pointing at the character. */
  .scene-bubble::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 14px;
    width: 8px;
    height: 8px;
    background: hsl(var(--background));
    border-left: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
    transform: rotate(45deg);
  }
  .scene:hover .scene-person,
  .scene:focus-within .scene-person { transform: rotate(5deg) translateY(-8px); }
  .scene:hover .scene-ink,
  .scene:focus-within .scene-ink { opacity: 1; }
  .scene:hover .scene-ring,
  .scene:focus-within .scene-ring { opacity: 0; }
  .scene:hover .scene-body path:first-child,
  .scene:focus-within .scene-body path:first-child { fill-opacity: 0.85; stroke-opacity: 1; }
  .scene:hover .scene-arm,
  .scene:focus-within .scene-arm { stroke: hsl(var(--background) / 0.4); }
  .scene:hover .scene-idle,
  .scene:focus-within .scene-idle { opacity: 0; }
  .scene:hover .scene-bubble,
  .scene:focus-within .scene-bubble {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 70ms + 40ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .scene-person, .scene-ink, .scene-ring, .scene-body path, .scene-idle, .scene-bubble { transition: none; }
  }
</style>

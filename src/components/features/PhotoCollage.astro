---
import memoriesData from '@/data/memories.json'
interface PhotoItem { src: string; caption: string }
interface Props { photos?: PhotoItem[] }
const { photos = memoriesData } = Astro.props
---
<section class="border-t border-border pt-8" aria-labelledby="journal-title">
  <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 id="journal-title" class="font-title text-display-sm">People &amp; places</h2>
      <p class="mt-2 text-sm text-muted-foreground">My photo journal, beyond the screen. Select a photograph for a closer look.</p>
    </div>
    <p class="font-mono text-xs text-muted-foreground">{photos.length} photographs</p>
  </div>
  <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
    {photos.map(item => (
      <figure class="min-w-0">
        <button type="button" data-photo aria-label={`Open photo: ${item.caption}`} class="block w-full cursor-zoom-in text-left focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
          <img src={item.src} alt={item.caption} width="600" height="400" loading="lazy" decoding="async" class="aspect-3/2 w-full rounded-sm bg-muted object-cover" />
          <span class="sr-only">{item.caption}</span>
        </button>
        <figcaption class="mt-3 border-l border-border pl-3 text-sm leading-relaxed text-muted-foreground">{item.caption}</figcaption>
      </figure>
    ))}
  </div>
  <dialog id="photo-lightbox" aria-label="Photo viewer" class="m-auto max-h-dvh max-w-full bg-background p-4 text-foreground backdrop:bg-black/70">
    <button type="button" data-close-photo class="mb-3 block cursor-pointer px-3 py-2 text-sm underline">Close photo &times;</button>
    <figure class="flex max-w-5xl flex-col items-center gap-3">
      <img alt="" class="max-h-[75dvh] w-auto max-w-full object-contain" />
      <figcaption class="max-w-prose text-center text-sm"></figcaption>
    </figure>
  </dialog>
</section>
<script>
  const dialog = document.getElementById('photo-lightbox') as HTMLDialogElement | null
  const big = dialog?.querySelector('img')
  const caption = dialog?.querySelector('figcaption')

  function open(card: HTMLElement) {
    const img = card.querySelector('img')
    const text = card.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? ''
    if (!dialog || !big || !caption || !img) return
    big.src = img.currentSrc || img.src
    big.alt = text
    caption.textContent = text
    dialog.showModal()
  }

  document.addEventListener('click', (e) => {
    const card = (e.target as Element).closest<HTMLElement>('[data-photo]')
    if (card) open(card)
  })
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog || (event.target as Element).closest('[data-close-photo]')) dialog.close()
  })
</script>

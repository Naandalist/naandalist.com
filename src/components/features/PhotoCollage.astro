---
/**
 * Aesthetic Photo Collage component for Core Memories with friends.
 * Follows clean uniform aspect ratios, enlarged 2-line wrapped captions,
 * no AI-slop dots, and auto marquee if photos > 3.
 * Photos are plain <img> tags. Build-time image optimization fetched remote photos, which failed on CI runners.
 */

import memoriesData from '@/data/memories.json'

interface PhotoItem {
  src: string
  caption: string
}

interface Props {
  photos?: PhotoItem[]
}

const { photos = memoriesData } = Astro.props

// Always marquee on mobile (< sm). On desktop (sm+), marquee if > 3 photos.
const isAlwaysMarquee = photos.length > 3
const marqueeItems = photos.length <= 3
  ? [...photos, ...photos, ...photos, ...photos]
  : [...photos, ...photos]
---

<section class="mt-2 pt-4 border-t border-border/50">
  <div class="mb-5">
    <h2 class="font-title text-2xl max-sm:leading-tight sm:text-display-sm text-foreground">
      Core Memories
    </h2>
    <p class="text-sm text-muted-foreground mt-1">
      A few moments with the people I met along the way.
    </p>
  </div>

  {/* Mobile Marquee (always active on mobile < sm, and everywhere if > 3 photos) */}
  <div class={`group relative -mx-4 sm:-mx-6 px-4 sm:px-6 overflow-hidden py-2 ${isAlwaysMarquee ? 'block' : 'block sm:hidden'}`}>
    {/* Gradient edge fades */}
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-10 sm:w-12 bg-linear-to-r from-background to-transparent" />
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-10 sm:w-12 bg-linear-to-l from-background to-transparent" />

    <div class="animate-core-marquee gap-4 sm:gap-5">
      {marqueeItems.map((item) => (
        <figure class="w-72 sm:w-84 shrink-0 flex flex-col overflow-hidden rounded-lg border border-border/80 bg-card/80 p-3 sm:p-4 shadow-1 transition-all duration-150 hover:border-foreground/40 hover:-translate-y-1 hover:shadow-2">
          {/* Uniform Aspect Ratio Photo (3:2 auto fit center) */}
          <div class="relative w-full aspect-3/2 overflow-hidden rounded-md bg-secondary/50 border border-border/40">
            <img
              src={item.src}
              alt={item.caption}
              width={600}
              height={400}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center grayscale contrast-110 transition-all duration-200 ease-out hover:grayscale-0"
            />
            <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/25 via-transparent to-transparent opacity-40" />
          </div>

          {/* Aesthetic Caption */}
          <figcaption class="mt-2.5 sm:mt-3 w-full">
            <p class="text-xs sm:text-sm text-muted-foreground sm:text-foreground/80 leading-relaxed font-normal">
              {item.caption}
            </p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  {/* Desktop Grid (rendered only when <= 3 photos on screens >= sm) */}
  {!isAlwaysMarquee && (
    <div class="hidden sm:grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {photos.map((item) => (
        <figure class="group flex flex-col overflow-hidden rounded-lg border border-border/80 bg-card/80 p-4 shadow-1 transition-all duration-150 hover:border-foreground/40 hover:-translate-y-1 hover:shadow-2">
          {/* Uniform Aspect Ratio Photo (3:2 auto fit center) */}
          <div class="relative w-full aspect-3/2 overflow-hidden rounded-md bg-secondary/50 border border-border/40">
            <img
              src={item.src}
              alt={item.caption}
              width={600}
              height={400}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center grayscale contrast-110 transition-all duration-200 ease-out group-hover:grayscale-0 group-hover:scale-105"
            />
            <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/25 via-transparent to-transparent opacity-40 group-hover:opacity-10 transition-opacity duration-150" />
          </div>

          {/* Aesthetic Caption */}
          <figcaption class="mt-2.5 sm:mt-3 w-full">
            <p class="text-xs sm:text-sm text-muted-foreground sm:text-foreground/80 leading-relaxed font-normal">
              {item.caption}
            </p>
          </figcaption>
        </figure>
      ))}
    </div>
  )}
</section>

<style>
  @keyframes core-memories-marquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .animate-core-marquee {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: core-memories-marquee 30s linear infinite;
  }

  .animate-core-marquee:hover,
  .group:hover .animate-core-marquee {
    animation-play-state: paused;
  }
</style>

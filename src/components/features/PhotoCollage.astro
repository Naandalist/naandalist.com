---
/**
 * Core Memories: photo cards in an endless marquee scrolling left at every width, across the
 * full viewport. Photos are grayscale; hovering the row pauses it and the hovered card's photo
 * turns to colour.
 * Photos are plain <img> tags. Build-time image optimization fetched remote photos, which failed on CI runners.
 */

import memoriesData from '@/data/memories.json'

interface PhotoItem {
  src: string
  caption: string
}

interface Props {
  photos?: PhotoItem[]
}

const { photos = memoriesData } = Astro.props

// The strip is two identical halves and the animation slides by one half, so the loop is seamless.
// Photos repeat until each half holds at least 8 cards (about 2800px), wider than a 2560px screen.
const MIN_HALF = 8
const half = Array.from({ length: Math.ceil(MIN_HALF / photos.length) }, () => photos).flat()
const marqueeItems = [...half, ...half]
---

<section class="mt-2 pt-4 border-t border-border/50">
  <div class="mb-5">
    <h2 class="font-title text-2xl max-sm:leading-tight sm:text-display-sm text-foreground">
      Core Memories
    </h2>
    <p class="text-sm text-muted-foreground mt-1">
      A few moments with the people I met along the way.
    </p>
  </div>

  {/* Full bleed: the strip spans the viewport while the heading stays in the container. The body
      clips horizontal overflow, so 100vw counting the scrollbar never adds a sideways scroll. */}
  <div class="group relative mx-[calc(50%-50vw)] overflow-hidden py-2">
    {/* Gradient edge fades at the viewport edges */}
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 sm:w-24 bg-linear-to-r from-background to-transparent" />
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 sm:w-24 bg-linear-to-l from-background to-transparent" />

    {/* 5s per card keeps the same speed however many cards a half holds. */}
    <div class="animate-core-marquee gap-4 sm:gap-5" style={`--marquee-duration: ${half.length * 5}s`}>
      {marqueeItems.map((item, i) => (
        <figure
          aria-hidden={i >= half.length ? 'true' : undefined}
          class="group/card w-72 sm:w-84 shrink-0 flex flex-col overflow-hidden rounded-lg border border-border/80 bg-card/80 p-3 sm:p-4 shadow-1 transition-all duration-150 hover:border-foreground/40 hover:-translate-y-1 hover:shadow-2"
        >
          {/* Uniform Aspect Ratio Photo (3:2 auto fit center) */}
          <div class="relative w-full aspect-3/2 overflow-hidden rounded-md bg-secondary/50 border border-border/40">
            <img
              src={item.src}
              alt={i >= half.length ? '' : item.caption}
              width={600}
              height={400}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center grayscale transition-[filter] duration-300 group-hover/card:grayscale-0 motion-reduce:transition-none"
            />
            <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/25 via-transparent to-transparent opacity-40" />
          </div>

          {/* Aesthetic Caption */}
          <figcaption class="mt-2.5 sm:mt-3 w-full">
            <p class="text-xs sm:text-sm text-muted-foreground sm:text-foreground/80 leading-relaxed font-normal">
              {item.caption}
            </p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes core-memories-marquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .animate-core-marquee {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: core-memories-marquee var(--marquee-duration, 30s) linear infinite;
  }

  .animate-core-marquee:hover,
  .group:hover .animate-core-marquee {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-core-marquee {
      animation-play-state: paused;
    }
  }
</style>

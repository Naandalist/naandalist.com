---
/** List row for an npm package. Same editorial row as BlogCard: meta on the left, text on the right. */
import type { CollectionEntry } from 'astro:content'
import Link from '@/components/Link.astro'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

const { entry } = Astro.props as { entry: CollectionEntry<'npmjs'> }
const { name, description, version, license, date, updated } = entry.data
---

<article class="glint not-prose relative rounded-lg border border-border/60 bg-card/10 p-(--space-card) shadow-1 backdrop-blur-xs">
  <Link href={`/npmjs/${entry.id}`} class="group grid gap-4 sm:grid-cols-[8rem_minmax(0,1fr)]">
    <div class="flex gap-3 text-xs text-muted-foreground sm:flex-col sm:gap-2">
      <time datetime={(updated ?? date).toISOString()} class="font-mono">{formatDate(updated ?? date)}</time>
      <span class="font-mono">v{version} · {license}</span>
    </div>
    <div class="min-w-0">
      <h3 class="flex items-center gap-2 font-mono text-xl font-semibold leading-snug decoration-border underline-offset-4 group-hover:underline sm:text-2xl">
        <Icon name="lucide:package" class="size-5 shrink-0 text-muted-foreground" aria-hidden="true" />
        <span class="min-w-0 break-words">{name}</span>
      </h3>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{description}</p>
      <span class="mt-4 inline-block text-xs font-medium">View package <span aria-hidden="true">↗</span></span>
    </div>
  </Link>
</article>

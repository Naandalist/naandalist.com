---
/** List row for an npm package. Same editorial row as BlogCard: meta on the left, text on the right. */
import type { CollectionEntry } from 'astro:content'
import Link from '@/components/Link.astro'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

const { entry, layout = 'row' } = Astro.props as {
  entry: CollectionEntry<'npmjs'>
  layout?: 'row' | 'stack'
}
const stacked = layout === 'stack'
const { name, description, version, license, date, updated } = entry.data
---

<article class:list={['glass-card glint not-prose relative rounded-lg border-1 p-(--space-card) shadow-1 backdrop-blur-md', stacked && 'h-full']}>
  <Link
    href={`/npmjs/${entry.id}`}
    class:list={[
      'group',
      stacked
        ? 'flex h-full flex-col gap-3'
        : 'grid gap-4 sm:grid-cols-[8rem_minmax(0,1fr)]',
    ]}
  >
    <div class:list={['flex gap-3 text-xs text-muted-foreground', !stacked && 'sm:flex-col sm:gap-2']}>
      <time datetime={(updated ?? date).toISOString()} class="font-mono">{formatDate(updated ?? date)}</time>
      <span class="font-mono">v{version} · {license}</span>
    </div>
    <div class:list={['min-w-0', stacked && 'flex flex-1 flex-col']}>
      <h3 class:list={['font-mono font-semibold leading-snug decoration-border underline-offset-4 group-hover:underline', stacked ? 'flex flex-col items-start gap-2 text-xl' : 'flex items-center gap-2 text-xl sm:text-2xl']}>
        <Icon name="lucide:package" class="size-5 shrink-0 text-muted-foreground" aria-hidden="true" />
        <span class="min-w-0 break-words">{name}</span>
      </h3>
      <p class:list={['text-sm leading-relaxed text-muted-foreground', stacked ? 'mt-2 line-clamp-3' : 'mt-3']}>{description}</p>
      <span class:list={['inline-block text-xs font-medium', stacked ? 'mt-auto pt-4' : 'mt-4']}>View package <span aria-hidden="true">↗</span></span>
    </div>
  </Link>
</article>

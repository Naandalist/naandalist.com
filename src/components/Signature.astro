---
import { SIGNATURE } from '@/lib/signature-path'
---

<!-- Decorative: the surrounding link carries the accessible name.
     The whole word is tilted 25 degrees, rising to the right like the Dribbble wordmark. -->
<svg
  class="signature h-6 w-auto -rotate-25"
  viewBox={`0 0 ${SIGNATURE.width} ${SIGNATURE.height}`}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={SIGNATURE.d}></path>
</svg>

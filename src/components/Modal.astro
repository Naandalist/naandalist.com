---
interface Props {
  id: string
  title: string
}

const { id, title } = Astro.props
---

<!-- Trigger: 44x44 minimum touch target (Apple HIG) -->
<button
  type="button"
  data-modal-open={id}
  class="inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
>
  Open
</button>

<!-- Dialog: bottom sheet on mobile, centered on sm+ -->
<dialog
  id={id}
  class="m-0 max-h-dvh max-w-full rounded-none bg-transparent p-0 backdrop:bg-black/60 backdrop:backdrop-blur-sm sm:mx-auto sm:max-w-lg"
>
  <div
    class="flex max-h-dvh flex-col overflow-hidden rounded-t-xl bg-background shadow-3 pb-[max(1.5rem,env(safe-area-inset-bottom))] sm:rounded-xl sm:pb-6"
  >
    <header class="flex items-center justify-between border-b p-4 sm:p-6">
      <h2 class="text-lg font-semibold">{title}</h2>
      <button
        type="button"
        data-modal-close={id}
        class="flex h-11 w-11 items-center justify-center rounded-full hover:bg-secondary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        aria-label="Close"
      >
        <span aria-hidden="true">✕</span>
      </button>
    </header>
    <div class="flex-1 overflow-y-auto p-4 sm:p-6">
      <slot />
    </div>
  </div>
</dialog>

<script>
  function wireDialogs() {
    document
      .querySelectorAll<HTMLDialogElement>('dialog[id]')
      .forEach((d) => {
        document
          .querySelectorAll<HTMLElement>(`[data-modal-open="${d.id}"]`)
          .forEach((b) =>
            b.addEventListener('click', (e) => {
              e.preventDefault()
              d.showModal()
            }),
          )
        document
          .querySelectorAll<HTMLElement>(`[data-modal-close="${d.id}"]`)
          .forEach((b) =>
            b.addEventListener('click', (e) => {
              e.preventDefault()
              d.close()
            }),
          )
        // Tap outside (on backdrop) closes
        d.addEventListener('click', (e) => {
          if (e.target === d) d.close()
        })
        // Esc closes (browser default, but explicit for clarity)
        d.addEventListener('cancel', () => d.close())
      })
  }
  document.addEventListener('astro:page-load', wireDialogs)
</script>

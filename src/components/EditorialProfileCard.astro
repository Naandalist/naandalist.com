---
interface RoleLink {
  /** Text inside `role` to turn into a link, e.g. "Dicoding" */
  text: string
  href: string
}

interface Props {
  id: string
  name: string
  avatar?: string
  bio?: string
  role?: string
  roleLinks?: RoleLink[]
  location?: string
  pronouns?: string
  github?: string
  linkedin?: string
  instagram?: string
  website?: string
  mail?: string
  linkDisabled?: boolean
}

const {
  id,
  name,
  avatar,
  bio,
  role,
  roleLinks = [],
  location,
  pronouns,
  github,
  linkedin,
  instagram,
  website,
  mail,
  linkDisabled = false,
} = Astro.props

// Splits the role line so each matching text becomes a link. Text without a match stays plain.
const escapeRe = (t: string) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
const roleParts = (role: string): { text: string; href?: string }[] => {
  if (roleLinks.length === 0) return [{ text: role }]
  const pattern = new RegExp(`(${roleLinks.map((l) => escapeRe(l.text)).join('|')})`)
  return role.split(pattern).filter(Boolean).map((text) => ({ text, href: roleLinks.find((l) => l.text === text)?.href }))
}

const socialLinks = [
  website && { href: website, label: 'Website' },
  github && { href: github, label: 'GitHub' },
  linkedin && { href: linkedin, label: 'LinkedIn' },
  instagram && { href: instagram, label: 'Instagram' },
  mail && { href: `mailto:${mail}`, label: 'Email' },
].filter(Boolean) as { href: string; label: string }[]
---

<header class="flex flex-col gap-6 border-b border-border pb-8 sm:flex-row-reverse sm:items-start sm:justify-between">
  <img src={avatar || '/static/profile/avatar.png'} alt={`Profile photo of ${name}`} width="96" height="96" loading="eager" decoding="async" class="size-24 shrink-0 rounded-full object-cover" />
  <div class="min-w-0 max-w-3xl">
    <p class="mb-3 font-mono text-xs uppercase tracking-widest text-muted-foreground">Profile / {id}</p>
    <h1 class="font-title text-display-md">{linkDisabled ? name : <a href={`/authors/${id}`}>{name}</a>}</h1>
    {pronouns && <p class="mt-2 text-sm text-muted-foreground">{pronouns}</p>}
    {bio && <p class="mt-3 text-lg">{bio}</p>}
    {role && <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{roleParts(role).map(part => part.href ? <a href={part.href} class="underline underline-offset-4" target="_blank" rel="noopener noreferrer">{part.text}</a> : part.text)}</p>}
    {location && <p class="mt-2 font-mono text-xs text-muted-foreground">{location}</p>}
    <nav aria-label={`Links for ${name}`} class="mt-6 flex flex-wrap gap-x-5 gap-y-3 text-sm">
      {socialLinks.map(item => <a href={item.href} class="underline decoration-border underline-offset-4 hover:decoration-foreground" target="_blank" rel="noopener noreferrer">{item.label}</a>)}
    </nav>
  </div>
</header>

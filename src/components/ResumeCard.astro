---
import type { ResumeEntry } from "@utils/resumes";

type Props = {
  resume: ResumeEntry;
};

const { resume } = Astro.props;
---

<a
  href={resume.href}
  class="group block rounded-lg border border-white/20 p-4 transition-[border-color,box-shadow] duration-300 ease-in-out hover:border-white/40 hover:shadow-[0_0_18px] hover:shadow-white/15"
>
  <h2 class="font-semibold text-lg text-white">
    {resume.title}
  </h2>
  <p class="mt-1 text-sm text-white/70">
    {resume.role}
  </p>
</a>

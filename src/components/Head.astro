---
import '../styles/global.css'
import '../styles/katex.css'

import { SITE } from '@/consts'
import { ClientRouter } from 'astro:transitions'
import { serializeLd } from '@/lib/jsonld'

interface Props {
  title: string
  description: string
  image?: string
  /** Alt text for the Open Graph / Twitter image. Defaults to the page title. */
  imageAlt?: string
  /** schema.org objects for this page, written as JSON-LD. */
  jsonLd?: object[]
  ogType?: 'website' | 'article'
  noindex?: boolean
  published?: Date
  modified?: Date
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const DEFAULT_OG = '/static/profile/1200x630.jpg'

const {
  title,
  description,
  image = DEFAULT_OG,
  imageAlt = title,
  jsonLd = [],
  ogType = 'website',
  noindex = false,
  published,
  modified,
} = Astro.props

const ogImage = new URL(image, Astro.url)
const isDefaultOg = image === DEFAULT_OG
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.TITLE} href="/rss.xml" />
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
<link rel="preload" href="/fonts/GeistVF.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/GeistMonoVF.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/InstrumentSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}

<link rel="icon" href="/favicons/favicon.ico" type="image/x-icon">
<link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
<meta name="msapplication-TileColor" content="#121212" />
<meta name="theme-color" content="#121212" />

<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en_US" />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
{jsonLd.length > 0 && <script is:inline type="application/ld+json" set:html={serializeLd(jsonLd)} />}
<meta property="og:url" content={Astro.url} />
<meta property="og:site_name" content={SITE.TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
{isDefaultOg && <meta property="og:image:width" content="1200" />}
{isDefaultOg && <meta property="og:image:height" content="800" />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@nawndalist" />
<meta name="twitter:creator" content="@nawndalist" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="preconnect" href="https://avatars.githubusercontent.com" />
<link rel="preconnect" href="https://lastfm-last-played.biancarosa.com.br" crossorigin />
<link rel="dns-prefetch" href="https://lastfm.freetls.fastly.net" />
<ClientRouter />

<script is:inline>
  // The signature writes on every full page load; in-app navigation swaps <html> and clears it.
  document.documentElement.dataset.sign = '1'
  // First visit of a session: let intro animations play. Later page changes stay instant.
  try {
    if (!sessionStorage.getItem('revealed')) {
      document.documentElement.dataset.reveal = '1'
      sessionStorage.setItem('revealed', '1')
    }
  } catch (_) {}
</script>

<script is:inline>
  function setDarkMode(document) {
    const getThemePreference = () => {
      if (
        typeof localStorage !== 'undefined' &&
        localStorage.getItem('theme')
      ) {
        return localStorage.getItem('theme')
      }
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'theme-light'
    }
    const isDark = getThemePreference() === 'dark'
    document.documentElement.classList[isDark ? 'add' : 'remove']('dark')

    // Attach the observer once. Each page change would otherwise add another one.
    if (typeof localStorage !== 'undefined' && !window.__themeObserver) {
      window.__themeObserver = new MutationObserver(() => {
        const isDark = document.documentElement.classList.contains('dark')
        localStorage.setItem('theme', isDark ? 'dark' : 'theme-light')
      })
      window.__themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class'],
      })
    }
  }

  setDarkMode(document)

  document.addEventListener('astro:before-swap', (ev) => {
    // Pass the incoming document to set the theme on it
    setDarkMode(ev.newDocument)
  })

  document.addEventListener('astro:after-swap', () => {
    document.querySelectorAll('video').forEach((v) => {
      try {
        v.load()
      } catch (_) {}
    })
  })
</script>
---
import type { CollectionEntry } from 'astro:content'
import Link from '@/components/Link.astro'
import { formatDate, readingTime } from '@/lib/utils'

const { entry, layout = 'row' } = Astro.props as {
  entry: CollectionEntry<'blog'>
  layout?: 'row' | 'stack'
}

const stacked = layout === 'stack'
const formattedDate = formatDate(entry.data.date)
const readTime = readingTime(entry.body ?? '')
---

<article class:list={['glass-card glint not-prose relative rounded-lg border-1 p-(--space-card) shadow-1 backdrop-blur-md', stacked && 'h-full']}>
  <Link
    href={`/${entry.collection}/${entry.id}`}
    class:list={[
      'group',
      stacked
        ? 'flex h-full flex-col gap-3'
        : 'grid gap-4 sm:grid-cols-[8rem_minmax(0,1fr)]',
    ]}
  >
    <div class:list={['flex gap-3 text-xs text-muted-foreground', !stacked && 'sm:flex-col sm:gap-2']}>
      <time datetime={entry.data.date.toISOString()} class="font-mono">{formattedDate}</time>
      <span>{readTime}</span>
    </div>
    <div class:list={['min-w-0', stacked && 'flex flex-1 flex-col']}>
      <h3 class:list={['font-semibold leading-snug decoration-border underline-offset-4 group-hover:underline', stacked ? 'text-xl' : 'text-xl sm:text-2xl']}>{entry.data.title}</h3>
      <p class:list={['text-sm leading-relaxed text-muted-foreground', stacked ? 'mt-2 line-clamp-3' : 'mt-3']}>{entry.data.description}</p>
      <span class:list={['inline-block text-xs font-medium', stacked ? 'mt-auto pt-4' : 'mt-4']}>Read article <span aria-hidden="true">↗</span></span>
    </div>
  </Link>
</article>

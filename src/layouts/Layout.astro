---
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import NavLoader from '@/components/NavLoader.astro'
import WaterDitherBackground from '@/components/background/WaterDitherBackground.tsx'
import { SITE } from '@/consts'
import SpeedInsights from '@vercel/speed-insights/astro'

type Props = {
  title: string
  description: string
  image?: string
  fullTitle?: string
  jsonLd?: object[]
  ogType?: 'website' | 'article'
  noindex?: boolean
  published?: Date
  modified?: Date
}

const { title, description, image, fullTitle, jsonLd, ogType, noindex, published, modified } = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <Head
      title={fullTitle ?? `${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
      jsonLd={jsonLd}
      ogType={ogType}
      noindex={noindex}
      published={published}
      modified={modified}
    />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased relative">
    <WaterDitherBackground client:only="react" transition:persist />
    <div class="relative z-10 flex min-h-dvh flex-col">
      <Header />
      <main class="flex-1">
        <div class="py-section-sm">
          <slot />
        </div>
      </main>
      <Footer />
    </div>
    <NavLoader />
    <SpeedInsights />
    <script>
      import { initLinkTooltip } from '@/lib/link-tooltip'
      import { initUiSound } from '@/lib/ui-sound'
      initUiSound()
      initLinkTooltip()
    </script>
  </body>
</html>

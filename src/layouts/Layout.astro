---
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import NavLoader from '@/components/NavLoader.astro'
import GalaxyBackground from '@/components/background/GalaxyBackground.tsx'
import { SITE } from '@/consts'
import SpeedInsights from '@vercel/speed-insights/astro'

type Props = {
  title: string
  description: string
  image?: string
  imageAlt?: string
  fullTitle?: string
  jsonLd?: object[]
  ogType?: 'website' | 'article'
  noindex?: boolean
  /** Hides the navbar and footer, for pages that stand alone such as 404. */
  bare?: boolean
  published?: Date
  modified?: Date
}

const { title, description, image, imageAlt, fullTitle, jsonLd, ogType, noindex, bare, published, modified } = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <Head
      title={fullTitle ?? `${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
      imageAlt={imageAlt}
      jsonLd={jsonLd}
      ogType={ogType}
      noindex={noindex}
      published={published}
      modified={modified}
    />
  </head>
  <body class="min-h-screen overflow-x-clip bg-background text-foreground antialiased relative">
    <GalaxyBackground client:only="react" transition:persist />
    <div class="relative z-10 flex min-h-dvh flex-col">
      {!bare && <Header />}
      <main class:list={['flex-1', bare && 'flex flex-col']}>
        <div class:list={['py-section-sm', bare && 'flex flex-1 flex-col']}>
          <slot />
        </div>
      </main>
      {!bare && <Footer />}
    </div>
    <NavLoader />
    <SpeedInsights />
    <script>
      import { initLinkTooltip } from '@/lib/link-tooltip'
      import { initUiSound } from '@/lib/ui-sound'
      import { initImageLoading } from '@/lib/image-loading'
      initUiSound()
      initLinkTooltip()
      initImageLoading()
    </script>
  </body>
</html>

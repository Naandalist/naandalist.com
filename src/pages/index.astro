---
import BlogCard from '@/components/BlogCard.astro'
import PackageCard from '@/components/PackageCard.astro'
import Container from '@/components/Container.astro'
import Link from '@/components/Link.astro'
import ExperienceTimeline from '@/components/features/ExperienceTimeline.astro'
import { ProjectsShowcase } from '@/components/features/ProjectsShowcase.tsx'
import LastfmPresence from '@/components/features/LastfmPresence.tsx'
import TechStackSlider from '@/components/features/TechStackSlider.tsx'
import WakatimeBox from '@/components/features/WakatimeBox.tsx'
import ResumeButton from '@/components/features/ResumeButton.astro'
import ProfileCard from '@/components/profile/ProfileCard.tsx'
import GithubGraph from '@/components/features/GithubGraph.tsx'
import { SITE } from '@/consts'
import { loadContributions } from '@/lib/github'
import { memo, withTimeout } from '@/lib/memo'
import Layout from '@/layouts/Layout.astro'
import { getImage } from 'astro:assets'
import { getCollection, getEntry } from 'astro:content'
import { describe, personLd, websiteLd } from '@/lib/jsonld'

const author = await getEntry('authors', 'naandalist')
const home = author?.data.home
// Fetch the avatar at build time and serve it from this origin as webp (falls back to the remote URL).
const avatarRemote = (author?.data.avatar ?? '/static/profile/avatar.png').replace('size=96', 'size=192')
const avatarSrc = await memo('home-avatar', 60 * 60 * 1000, () =>
  withTimeout(getImage({ src: avatarRemote, width: 160, height: 160, format: 'webp' }).then((i) => i.src), 6000, avatarRemote),
).catch(() => avatarRemote)

// Fetched at build time and cached in memory, so dev navigation does not wait on GitHub each time.
// A GITHUB_TOKEN env var makes it use the GraphQL API.
const contributions = await memo('home-contributions', 10 * 60 * 1000, () =>
  loadContributions({ user: 'naandalist', token: import.meta.env.GITHUB_TOKEN }),
)

const blog = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)

const packages = (await getCollection('npmjs'))
  .sort((a, b) => (b.data.updated ?? b.data.date).valueOf() - (a.data.updated ?? a.data.date).valueOf())
  .slice(0, SITE.NUM_PACKAGES_ON_HOMEPAGE)

const rawProjects = (await getCollection('projects'))
  .sort((a, b) => {
    // date is 'Month Year' string e.g. 'May 2025'; parse to Date for comparison
    const toDate = (d?: string) => d ? new Date(d) : new Date(0)
    return toDate(b.data.date).valueOf() - toDate(a.data.date).valueOf()
  })
  // Info Haji always goes last, whatever its date.
  .sort((a, b) => Number(a.id === 'mobile-app-info-haji') - Number(b.id === 'mobile-app-info-haji'))
const projectsData = rawProjects.map((p) => ({
  slug: p.id,
  hasCaseStudy: Boolean(p.body?.trim()),
  name: p.data.name,
  description: p.data.description,
  tags: p.data.tags,
  type: p.data.type ?? [],
  asset: p.data.asset,
  fallback: p.data.fallback,
  link: p.data.link,
  github: p.data.github,
  date: p.data.date,
  techStack: p.data.techStack,
}))
const siteUrl = new URL('/', Astro.site).href
const homeDescription = describe(author?.data.home?.tagline ?? SITE.DESCRIPTION)
const jsonLd = [
  websiteLd({ name: SITE.TITLE, alternateName: ['naandalist'], url: siteUrl, description: homeDescription }),
  {
    '@context': 'https://schema.org',
    ...personLd({
      name: author?.data.name ?? 'Listiananda Apriliawan',
      alternateName: 'Naandalist',
      url: siteUrl,
      image: new URL('/static/profile/avatar.png', siteUrl).href,
      jobTitle: author?.data.home?.role ?? author?.data.role,
      description: homeDescription,
      email: author?.data.mail,
      sameAs: [author?.data.github, author?.data.linkedin, author?.data.instagram, author?.data.twitter],
    }),
  },
]
---

<Layout
  title="Home"
  description={homeDescription}
  fullTitle="Listiananda Apriliawan, Product Engineer"
  imageAlt="Listiananda Apriliawan, product engineer working on web and mobile apps"
  jsonLd={jsonLd}
>
  <Container class="flex flex-col gap-y-6 reveal-stack">
    <section class="grid grid-cols-1 items-stretch gap-3 sm:gap-4 lg:grid-cols-[minmax(0,36rem)_1fr]">
      <ProfileCard
        client:load
        name={author?.data.name ?? 'Listiananda Apriliawan'}
        role={home?.role ?? ''}
        roleLinks={[
          { text: 'ZOG', href: 'https://zero-one-group.com/' },
          { text: 'Dicoding', href: 'https://www.dicoding.com/' },
        ]}
        pronunciation={home?.pronunciation}
        avatar={avatarSrc}
        links={[
          { kind: 'mail', label: author?.data.mail ?? SITE.EMAIL, href: `mailto:${author?.data.mail ?? SITE.EMAIL}` },
          { kind: 'linkedin', label: 'naandalist', href: author?.data.linkedin ?? 'https://linkedin.com/in/naandalist' },
          { kind: 'github', label: 'naandalist', href: author?.data.github ?? 'https://github.com/naandalist' },
          ...(home?.galleryUrl ? [{ kind: 'photo' as const, label: home.galleryLabel ?? home.galleryUrl, href: home.galleryUrl }] : []),
          { kind: 'chat', label: 'Ask my assistant', href: '/chat' },
        ]}
      />
      <div class="flex flex-col gap-4 rounded-lg border border-border/60 p-(--space-card) lg:border-0 shadow-1">
        <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">{home?.eyebrow}</p>
        <h2 class="font-title text-2xl max-sm:leading-tight sm:text-display-sm text-foreground">{home?.headline}</h2>
        <p class="max-w-md text-sm text-muted-foreground">
          {home?.tagline}
        </p>
        <div class="shrink-0">
          <ResumeButton resumeUrl={author?.data.resume} />
        </div>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-3 sm:gap-4 lg:grid-cols-12">
      <div role="region" aria-label="Wakatime Section"
        class="lg:col-span-6 flex h-44 sm:h-[210px] w-full flex-col items-start whitespace-nowrap rounded-lg border-1 glass-card backdrop-blur-md shadow-1 p-3 text-xs leading-loose text-foreground">
        <WakatimeBox omitLanguages={['Other']} client:visible />
      </div>

      <div role="region" aria-label="Last.fm Section"
        class="lg:col-span-6 flex h-44 sm:h-[210px] w-full flex-col items-start whitespace-nowrap rounded-lg border-1 glass-card backdrop-blur-md shadow-1 p-3 text-xs leading-loose text-foreground">
        <LastfmPresence client:visible />
      </div>

      <div role="region" aria-label="GitHub contributions"
        class="flex min-h-60 sm:min-h-72 w-full min-w-0 flex-col rounded-lg border-1 glass-card p-4 text-foreground shadow-1 backdrop-blur-md lg:col-span-7">
        <GithubGraph client:visible weeks={contributions.weeks} total={contributions.total} profileUrl="https://github.com/naandalist" />
      </div>

      <div role="region" aria-label="Tech Stack"
        class="flex min-h-64 sm:min-h-72 w-full flex-col overflow-hidden rounded-lg border-1 glass-card p-4 text-foreground shadow-1 backdrop-blur-md lg:col-span-5">
        <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground mb-3">My tech stack and Tools</p>
        <TechStackSlider client:idle />
      </div>

    </section>

    <section class="flex flex-col gap-y-4">
      <ExperienceTimeline>
        <h2 slot="heading" class="shrink-0 font-title text-2xl max-sm:leading-tight sm:text-display-sm">Experience</h2>
      </ExperienceTimeline>
    </section>

    <section class="flex flex-col gap-y-4">
      <ProjectsShowcase projects={projectsData} client:load />
    </section>

    <section class="flex flex-col gap-y-4">
      <div class="flex items-center justify-between gap-4">
        <h2 class="shrink-0 font-title text-2xl max-sm:leading-tight sm:text-display-sm">Latest posts</h2>
        <Link href="/blog" class="group shrink-0 text-sm text-foreground/80 transition-colors hover:text-foreground">
          See all <span class="inline-block transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">&nearr;</span>
        </Link>
      </div>
      <ul class="not-prose grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          blog.map((post) => (
            <li>
              <BlogCard entry={post} layout="stack" />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="flex flex-col gap-y-4">
      <div class="flex items-center justify-between gap-4 pt-8">
        <h2 class="shrink-0 font-title text-2xl max-sm:leading-tight sm:text-display-sm">Open source contributions</h2>
        <Link href="/npmjs" class="group shrink-0 text-sm text-foreground/80 transition-colors hover:text-foreground">
          See all <span class="inline-block transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">&nearr;</span>
        </Link>
      </div>
      <ul class="not-prose grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          packages.map((entry) => (
            <li>
              <PackageCard entry={entry} layout="stack" />
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>

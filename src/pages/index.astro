---
import BlogCard from '@/components/BlogCard.astro'
import PackageCard from '@/components/PackageCard.astro'
import Container from '@/components/Container.astro'
import Link from '@/components/Link.astro'
import ExperienceTimeline from '@/components/features/ExperienceTimeline.astro'
import { ProjectsShowcase } from '@/components/features/ProjectsShowcase.tsx'
import LastfmPresence from '@/components/features/LastfmPresence.tsx'
import TechStackSlider from '@/components/features/TechStackSlider.tsx'
import WakatimeBox from '@/components/features/WakatimeBox.tsx'
import ResumeButton from '@/components/features/ResumeButton.astro'
import { buttonVariants } from '@/components/ui/Button'
import GithubGraph from '@/components/features/GithubGraph.tsx'
import { SITE } from '@/consts'
import { loadContributions } from '@/lib/github'
import { memo, withTimeout } from '@/lib/memo'
import Layout from '@/layouts/Layout.astro'
import { getImage } from 'astro:assets'
import { getCollection, getEntry } from 'astro:content'
import { describe, personLd, websiteLd } from '@/lib/jsonld'

const author = await getEntry('authors', 'naandalist')
const home = author?.data.home
// Fetch the avatar at build time and serve it from this origin as webp (falls back to the remote URL).
const avatarRemote = (author?.data.avatar ?? '/static/profile/avatar.png').replace('size=96', 'size=192')
const avatarSrc = await memo('home-avatar', 60 * 60 * 1000, () =>
  withTimeout(getImage({ src: avatarRemote, width: 160, height: 160, format: 'webp' }).then((i) => i.src), 6000, avatarRemote),
).catch(() => avatarRemote)

// Fetched at build time and cached in memory, so dev navigation does not wait on GitHub each time.
// A GITHUB_TOKEN env var makes it use the GraphQL API.
const contributions = await memo('home-contributions', 10 * 60 * 1000, () =>
  loadContributions({ user: 'naandalist', token: import.meta.env.GITHUB_TOKEN }),
)

const blog = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)

const packages = (await getCollection('npmjs'))
  .sort((a, b) => (b.data.updated ?? b.data.date).valueOf() - (a.data.updated ?? a.data.date).valueOf())
  .slice(0, SITE.NUM_PACKAGES_ON_HOMEPAGE)

const rawProjects = (await getCollection('projects'))
  .sort((a, b) => {
    // date is 'Month Year' string e.g. 'May 2025'; parse to Date for comparison
    const toDate = (d?: string) => d ? new Date(d) : new Date(0)
    return toDate(b.data.date).valueOf() - toDate(a.data.date).valueOf()
  })
const projectsData = rawProjects.map((p) => ({
  slug: p.id,
  hasCaseStudy: Boolean(p.body?.trim()),
  name: p.data.name,
  description: p.data.description,
  tags: p.data.tags,
  type: p.data.type ?? [],
  asset: p.data.asset,
  fallback: p.data.fallback,
  link: p.data.link,
  github: p.data.github,
  date: p.data.date,
  techStack: p.data.techStack,
}))
const roleLinks = [
  { text: 'ZOG', href: 'https://zero-one-group.com/' },
  { text: 'Dicoding', href: 'https://www.dicoding.com/' },
]
const roleParts = (home?.role ?? '').split(/(ZOG|Dicoding)/).map(text => ({
  text,
  href: roleLinks.find(link => link.text === text)?.href,
}))
const homeLinks = [
  { kind: 'mail', label: author?.data.mail ?? SITE.EMAIL, href: `mailto:${author?.data.mail ?? SITE.EMAIL}` },
  { kind: 'linkedin', label: 'LinkedIn', href: author?.data.linkedin ?? 'https://linkedin.com/in/naandalist' },
  { kind: 'github', label: 'GitHub', href: author?.data.github ?? 'https://github.com/naandalist' },
  ...(home?.galleryUrl ? [{ kind: 'photo' as const, label: home.galleryLabel ?? home.galleryUrl, href: home.galleryUrl }] : []),
  { kind: 'chat', label: 'Ask my assistant', href: '/chat' },
]
const siteUrl = new URL('/', Astro.site).href
const homeDescription = describe(author?.data.home?.tagline ?? SITE.DESCRIPTION)
const jsonLd = [
  websiteLd({ name: SITE.TITLE, alternateName: ['naandalist'], url: siteUrl, description: homeDescription }),
  {
    '@context': 'https://schema.org',
    ...personLd({
      name: author?.data.name ?? 'Listiananda Apriliawan',
      alternateName: 'Naandalist',
      url: siteUrl,
      image: new URL('/static/profile/avatar.png', siteUrl).href,
      jobTitle: author?.data.home?.role ?? author?.data.role,
      description: homeDescription,
      email: author?.data.mail,
      sameAs: [author?.data.github, author?.data.linkedin, author?.data.instagram, author?.data.twitter],
    }),
  },
]
---

<Layout
  title="Home"
  description={homeDescription}
  fullTitle="Listiananda Apriliawan"
  imageAlt="Listiananda Apriliawan, product engineer working on web and mobile apps"
  jsonLd={jsonLd}
>
  <Container class="flex flex-col gap-y-12 sm:gap-y-16 reveal-stack">
    <header class="flex flex-col gap-8 border-b border-border pb-10 sm:pb-16">
      <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">{home?.eyebrow}</p>
      <h1 class="max-w-4xl font-title text-display text-foreground">{home?.headline}</h1>
      <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground">{home?.tagline}</p>
      <div class="flex flex-col gap-6 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-4">
          <img src={avatarSrc} alt={author?.data.name ?? 'Listiananda Apriliawan'} width="80" height="80" class="size-16 shrink-0 rounded-full object-cover sm:size-20" />
          <div class="min-w-0">
            <p class="text-lg font-semibold">{author?.data.name}</p>
            <p class="mt-1 text-sm text-muted-foreground">{roleParts.map(part => part.href ? <a href={part.href} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">{part.text}</a> : part.text)}</p>
            {home?.pronunciation && <p class="mt-1 font-mono text-xs text-muted-foreground">{home.pronunciation}</p>}
          </div>
        </div>
        <ResumeButton resumeUrl={author?.data.resume} />
      </div>
      <nav aria-label="Connect with Nanda" class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
        {homeLinks.map((link) => <a href={link.href} class="underline decoration-border underline-offset-4 hover:decoration-foreground">{link.label}</a>)}
        <button type="button" data-copy-email data-email={author?.data.mail ?? SITE.EMAIL} class="cursor-pointer underline decoration-border underline-offset-4 hover:decoration-foreground" aria-live="polite">Copy email</button>
        <a href="/about" class="font-medium underline underline-offset-4">More about me &rarr;</a>
      </nav>
    </header>

    <section class="flex flex-col gap-y-4">
      <ExperienceTimeline>
        <h2 slot="heading" class="shrink-0 font-title text-2xl max-sm:leading-tight sm:text-display-sm">Experience</h2>
      </ExperienceTimeline>
    </section>

    <section class="flex flex-col gap-y-4">
      <ProjectsShowcase projects={projectsData} client:visible />
    </section>

    <section class="flex flex-col gap-y-4">
      <div class="flex items-center gap-4">
        <h2 class="shrink-0 font-title text-2xl max-sm:leading-tight sm:text-display-sm">Latest posts</h2>
        {/* <div className="h-px flex-1 bg-border" /> */}
      </div>
      <ul class="not-prose flex flex-col gap-y-4">
        {
          blog.map((post) => (
            <li>
              <BlogCard entry={post} />
            </li>
          ))
        }
      </ul>
      <div class="flex justify-center">
        <Link
          href="/blog"
          class={buttonVariants({ variant: 'ghost' }) + ' group'}
        >
          See all posts <span
            class="ml-1.5 transition-transform group-hover:translate-x-1"
            >&rarr;</span
          >
        </Link>
      </div>
    </section>

    <section class="flex flex-col gap-y-4">
      <h2 class="shrink-0 font-title text-2xl max-sm:leading-tight sm:text-display-sm">Open source packages</h2>
      <ul class="not-prose flex flex-col gap-y-4">
        {
          packages.map((entry) => (
            <li>
              <PackageCard entry={entry} />
            </li>
          ))
        }
      </ul>
      <div class="flex justify-center">
        <Link
          href="/npmjs"
          class={buttonVariants({ variant: 'ghost' }) + ' group'}
        >
          See all packages <span
            class="ml-1.5 transition-transform group-hover:translate-x-1"
            >&rarr;</span
          >
        </Link>
      </div>
    </section>

    <section class="border-t border-border pt-8" aria-labelledby="activity-title">
      <h2 id="activity-title" class="font-title text-display-sm">Away from the finished work</h2>
      <p class="mt-2 mb-6 text-sm text-muted-foreground">Coding activity, tools, and what is playing while I work.</p>
      <details class="group border-y border-border">
        <summary class="cursor-pointer py-4 text-base font-medium focus-visible:outline-2 focus-visible:outline-ring">Open the activity notebook</summary>
        <div class="flex flex-col gap-8 py-6">
          <div role="region" aria-label="GitHub contributions" class="flex min-h-60 min-w-0 flex-col"><GithubGraph client:visible weeks={contributions.weeks} total={contributions.total} profileUrl="https://github.com/naandalist" /></div>
          <div role="region" aria-label="Tech Stack" class="flex min-h-64 flex-col overflow-hidden border-y border-border py-6"><TechStackSlider client:visible /></div>
          <div class="grid gap-8 md:grid-cols-2">
            <div role="region" aria-label="Wakatime Section" class="flex h-60 min-w-0 flex-col overflow-hidden text-xs"><WakatimeBox omitLanguages={['Other']} client:visible /></div>
            <div role="region" aria-label="Last.fm Section" class="flex h-60 min-w-0 flex-col overflow-hidden text-xs"><LastfmPresence client:visible /></div>
          </div>
        </div>
      </details>
    </section>
  </Container>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach(button => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.email ?? '')
        button.textContent = 'Email copied'
      } catch {
        button.textContent = 'Copy unavailable — use the email link'
      }
      window.setTimeout(() => { button.textContent = 'Copy email' }, 1800)
    })
  })
</script>

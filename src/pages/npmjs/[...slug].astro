---
import { type CollectionEntry } from "astro:content";

import NpmjsDetail from "@components/NpmjsDetail.astro";

import { getLocalizedStaticPaths } from "@lib/collection-paths";

export async function getStaticPaths() {
  return getLocalizedStaticPaths("npmjs", "en");
}

type Props = CollectionEntry<"npmjs">;

const pkg = Astro.props;
---

<NpmjsDetail pkg={pkg} lang="en" />

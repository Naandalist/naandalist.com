---
import BlogCard from '@/components/BlogCard.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import PaginationComponent from '@/components/ui/Pagination'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import type { PaginateFunction } from 'astro'
import { breadcrumbLd, collectionPageLd } from '@/lib/jsonld'
import { type CollectionEntry, getCollection } from 'astro:content'

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft)
  return paginate(
    allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    { pageSize: SITE.POSTS_PER_PAGE },
  )
}

const { page } = Astro.props

const postsByYear = page.data.reduce(
  (acc: Record<string, CollectionEntry<'blog'>[]>, post) => {
    const year = post.data.date.getFullYear().toString()
    if (!acc[year]) acc[year] = []
    acc[year].push(post)
    return acc
  },
  {},
)

const years = Object.keys(postsByYear).sort((a, b) => parseInt(b, 10) - parseInt(a, 10))
const pageTitle = page.currentPage > 1 ? `Blog · Page ${page.currentPage}` : 'Blog'
const pageDescription =
  'Notes on frontend, mobile, React Native, tooling, and shipping software that holds up in production.'

const siteUrl = new URL('/', Astro.site).href
const blogUrl = new URL('/blog/', siteUrl).href
const jsonLd = [
  collectionPageLd({
    type: 'Blog',
    url: new URL(page.currentPage > 1 ? `/blog/${page.currentPage}/` : '/blog/', siteUrl).href,
    name: pageTitle,
    description: pageDescription,
    items: page.data.map((post) => ({ name: post.data.title, url: new URL(`/blog/${post.id}/`, siteUrl).href })),
  }),
  breadcrumbLd([
    { name: 'Home', url: siteUrl },
    { name: 'Blog', url: blogUrl },
    ...(page.currentPage > 1 ? [{ name: `Page ${page.currentPage}`, url: new URL(`/blog/${page.currentPage}/`, siteUrl).href }] : []),
  ]),
]
---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <Container class="flex flex-col gap-y-6">
    <Breadcrumbs
      items={[
        { label: 'Blog', href: '/blog', icon: 'lucide:archive' },
        { label: `Page ${page.currentPage}`, icon: 'lucide:folder-open' },
      ]}
    />

    <header class="flex flex-col gap-4 border-b border-border pb-8">
      <h1 class="text-3xl font-semibold text-foreground">
        {page.currentPage > 1 ? `Blog · Page ${page.currentPage}` : 'Blog'}
      </h1>
      <p class="max-w-prose text-muted-foreground">{pageDescription}</p>
      <nav aria-label="Explore writing" class="flex gap-6 text-sm"><a href="/tags" class="underline underline-offset-4">Browse topics</a><a href="/rss.xml" class="underline underline-offset-4">RSS feed ↗</a></nav>
    </header>

    <div class="flex flex-col gap-y-8">
      {
        years.map((year) => (
          <section class="grid gap-2 md:grid-cols-[5rem_minmax(0,1fr)] md:gap-8">
            <h2 class="pt-6 font-mono text-sm text-muted-foreground">{year}</h2>
            <ul class="not-prose flex flex-col gap-4">
              {postsByYear[year].map((post) => (
                <li>
                  <BlogCard entry={post} />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <PaginationComponent
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      baseUrl="/blog/"
      client:load
    />
  </Container>
</Layout>

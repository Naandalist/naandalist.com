---
import EditorialProfileCard from '@/components/EditorialProfileCard.astro'
import PhotoCollage from '@/components/features/PhotoCollage.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import WorkTimeline from '@/components/features/WorkTimeline.astro'
import { renderInline } from '@/lib/inline-markup'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getEntry } from 'astro:content'
import { describe, personLd, profilePageLd } from '@/lib/jsonld'

const author = await getEntry('authors', 'naandalist')
const about = author?.data.about
const aboutUrl = new URL('/about/', Astro.site).href
const aboutDescription = describe(about?.intro ?? SITE.DESCRIPTION)
const jsonLd = [
  profilePageLd({
    url: aboutUrl,
    person: personLd({
      name: author?.data.name ?? 'Listiananda Apriliawan',
      alternateName: 'Naandalist',
      url: new URL('/', Astro.site).href,
      image: new URL('/static/profile/avatar.png', Astro.site).href,
      jobTitle: author?.data.home?.role ?? author?.data.role,
      description: aboutDescription,
      sameAs: [author?.data.github, author?.data.linkedin, author?.data.instagram, author?.data.twitter],
    }),
  }),
]
---

<Layout title="About" description={aboutDescription} jsonLd={jsonLd}>
  <Container class="flex flex-col gap-y-12 sm:gap-y-16">
    <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

    {author && (
      <EditorialProfileCard
        id={author.id}
        name={author.data.name}
        avatar={author.data.avatar}
        bio={author.data.bio}
        role={author.data.role}
        roleLinks={[
          { text: 'Zero One Group', href: 'https://zero-one-group.com/' },
          { text: 'Dicoding', href: 'https://www.dicoding.com/' },
        ]}
        location={author.data.location}
        pronouns={author.data.pronouns}
        github={author.data.github}
        linkedin={author.data.linkedin}
        instagram={author.data.instagram}
        website={author.data.website}
        mail={author.data.mail}
        linkDisabled
      />
    )}

    {about && (
      <section class="editorial-section" aria-labelledby="story-heading">
        <h2 id="story-heading" class="font-title text-display-sm">{about.greeting}</h2>
        <div class="flex flex-col gap-6">
          <p class="text-lg leading-relaxed text-muted-foreground" set:html={renderInline(about.intro)} />
          <aside class="border-l-2 border-foreground pl-5 text-sm leading-relaxed">
            <p class="mb-2 font-medium">{about.sceneLabel} {about.nickname}</p>
            {about.bubbles.map((text) => <p class="mt-2 text-muted-foreground">{text}</p>)}
          </aside>
        </div>
      </section>
      <section class="editorial-section" aria-labelledby="approach-heading">
        <h2 id="approach-heading" class="font-title text-display-sm">My approach</h2>
        <div>
          <h3 class="mb-4 text-xl font-semibold">{about.buildTitle}</h3>
          <p class="text-base leading-relaxed text-muted-foreground" set:html={renderInline(about.buildBody)} />
          <dl class="mt-8 divide-y divide-border border-y border-border">
            {about.highlights.map((item) => (
              <div class="grid gap-2 py-5 sm:grid-cols-3 sm:gap-6">
                <dt class="font-medium">{item.title}</dt>
                <dd class="text-sm leading-relaxed text-muted-foreground sm:col-span-2">{item.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    <WorkTimeline label="Where I have worked" />

    <PhotoCollage />
  </Container>
</Layout>

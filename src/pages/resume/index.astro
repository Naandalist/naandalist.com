---
import PageLayout from "@layouts/PageLayout.astro";

const pdfUrl =
  "/resume/Listiananda-Apriliawan-Fullstack-Engineer-Resume.pdf";
---

<PageLayout
  title="Resume — Listiananda Apriliawan"
  description="Professional resume of Listiananda Apriliawan, Fullstack Engineer."
  showHeader={false}
  showFooter={false}
  fullscreen={true}
  noindex={true}
  disableHreflang={true}
>
  <a
    href={pdfUrl}
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-neutral-900 focus:px-4 focus:py-2 focus:text-white"
  >
    Open or download the PDF directly
  </a>
  <iframe
    src={`${pdfUrl}#view=FitH&toolbar=1&navpanes=1`}
    title="Listiananda Apriliawan resume PDF"
    class="block h-dvh w-full border-0 bg-white"
  ></iframe>
</PageLayout>

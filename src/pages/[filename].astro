---
import { getResumeEntries, type ResumeEntry } from "@utils/resumes";

import PageLayout from "@layouts/PageLayout.astro";

export function getStaticPaths() {
  return getResumeEntries().map((resume) => ({
    params: { filename: resume.slug },
    props: { resume },
  }));
}

interface Props {
  resume: ResumeEntry;
}

const { resume } = Astro.props;
---

<PageLayout
  title={`${resume.title} — Resume`}
  description={`Professional resume: ${resume.title}.`}
  showHeader={false}
  showFooter={false}
  fullscreen={true}
  noindex={true}
  disableHreflang={true}
>
  <a
    href={resume.pdfUrl}
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-neutral-900 focus:px-4 focus:py-2 focus:text-white"
  >
    Open or download the PDF directly
  </a>
  <section
    data-pdf-viewer
    data-pdf-url={resume.pdfUrl}
    aria-label={`${resume.title} PDF viewer`}
    aria-busy="true"
    class="mobile-pdf-viewer min-h-dvh bg-neutral-200 p-2"
  >
    <div
      data-pdf-status
      role="status"
      class="flex min-h-dvh items-center justify-center text-sm text-neutral-700"
    >
      Loading PDF…
    </div>
    <div data-pdf-pages class="mx-auto flex max-w-4xl flex-col gap-2"></div>
    <a
      data-pdf-fallback
      href={resume.pdfUrl}
      class="mx-auto hidden min-h-dvh max-w-sm items-center justify-center px-6 text-center text-neutral-900 underline"
    >
      PDF preview unavailable. Open PDF directly.
    </a>
  </section>
  <iframe
    src={`${resume.pdfUrl}#view=FitH&toolbar=1&navpanes=1`}
    title={`${resume.title} PDF`}
    class="desktop-pdf-viewer block h-dvh w-full border-0 bg-white"></iframe>
</PageLayout>

<script>
  const viewer = document.querySelector<HTMLElement>("[data-pdf-viewer]");
  const mobileDevice = window.matchMedia(
    "(max-width: 767px), (hover: none) and (pointer: coarse)",
  );

  if (viewer && mobileDevice.matches) {
    document.documentElement.classList.add("pdfjs-mobile");

    const pages = viewer.querySelector<HTMLElement>("[data-pdf-pages]");
    const status = viewer.querySelector<HTMLElement>("[data-pdf-status]");
    const fallback = viewer.querySelector<HTMLElement>("[data-pdf-fallback]");
    const pdfUrl = viewer.dataset.pdfUrl;

    if (pages && status && fallback && pdfUrl) {
      try {
        const [{ GlobalWorkerOptions, getDocument }, { default: workerUrl }] =
          await Promise.all([
            import("pdfjs-dist"),
            import("pdfjs-dist/build/pdf.worker.min.mjs?url"),
          ]);

        GlobalWorkerOptions.workerSrc = workerUrl;

        const pdf = await getDocument({ url: pdfUrl }).promise;
        const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

        for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber += 1) {
          const page = await pdf.getPage(pageNumber);
          const baseViewport = page.getViewport({ scale: 1 });
          const renderViewport = page.getViewport({
            scale: pixelRatio,
          });
          const canvas = document.createElement("canvas");
          const context = canvas.getContext("2d", { alpha: false });

          if (!context) {
            throw new Error("Canvas rendering is unavailable");
          }

          canvas.width = Math.ceil(renderViewport.width);
          canvas.height = Math.ceil(renderViewport.height);
          canvas.style.maxWidth = `${Math.floor(baseViewport.width)}px`;
          canvas.className =
            "mx-auto block h-auto w-full bg-white shadow-sm";
          canvas.setAttribute("role", "img");
          canvas.setAttribute("aria-label", `Page ${pageNumber} of ${pdf.numPages}`);
          pages.append(canvas);

          await page.render({ canvas, canvasContext: context, viewport: renderViewport })
            .promise;
        }

        status.remove();
        viewer.setAttribute("aria-busy", "false");
      } catch (error) {
        console.error("Unable to render PDF preview", error);
        status.remove();
        fallback.classList.remove("hidden");
        fallback.classList.add("flex");
        viewer.setAttribute("aria-busy", "false");
      }
    }
  }
</script>

<style>
  .mobile-pdf-viewer {
    display: none;
  }

  @media (max-width: 767px), (hover: none) and (pointer: coarse) {
    :global(html.pdfjs-mobile),
    :global(html.pdfjs-mobile body) {
      overflow-x: hidden !important;
      overflow-y: auto !important;
      touch-action: pan-y pinch-zoom;
      -webkit-overflow-scrolling: touch;
    }

    :global(html.pdfjs-mobile) .mobile-pdf-viewer {
      display: block;
    }

    :global(html.pdfjs-mobile) .desktop-pdf-viewer {
      display: none;
    }
  }
</style>

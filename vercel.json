{
  "redirects": [
    { "source": "/posts", "destination": "/blog", "permanent": true },
    { "source": "/posts/:slug*", "destination": "/blog/:slug*", "permanent": true },
    { "source": "/projects", "destination": "/", "permanent": true },
    { "source": "/work", "destination": "/about#experience", "permanent": true },
    { "source": "/id", "destination": "/", "permanent": true },
    { "source": "/id/contact", "destination": "/about", "permanent": true },
    { "source": "/authors", "destination": "/about", "permanent": true },
    { "source": "/authors/", "destination": "/about", "permanent": true },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/sitemap.xml/", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/resume", "destination": "/resume/Listiananda-Apriliawan-Frontend-Engineer.pdf", "permanent": false }
  ],
  "headers": [
    {
      "source": "/resume/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(static|assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/((?!_astro/|static/|assets/|fonts/|favicons/).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, no-transform" }]
    }
  ]
}
